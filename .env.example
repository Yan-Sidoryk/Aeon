# Frontend. Copy to .env.local. Backend keys live in backend/.env (see backend/.env.example).
# NEXT_PUBLIC_ values are inlined into the browser bundle at build time: never put secrets here.

# Where the Aeon API (backend/) runs.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (anonymous sign-in first, work email at the save gate). Leave empty to use the per-browser
# X-Session-Id instead (demo / local). Use the project's anon (publishable) key, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
