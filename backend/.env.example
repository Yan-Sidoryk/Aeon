# Copy to backend/.env (gitignored). Never commit real keys.

# Anthropic (Claude): agents, the Claude engine, label checks, drafts, pre-MLR review
ANTHROPIC_API_KEY=

# DataForSEO: Google AI Overviews / AI Mode, questions people ask on Google, brand search volume
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Apify: competitors' current Google search ads (promo opportunities)
APIFY_TOKEN=

# Langfuse: traces + evals
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Supabase: Postgres + auth. Empty = SQLite (aeon.db) and anonymous X-Session-Id accounts.
# DATABASE_URL: the session pooler connection string (Project settings → Database → Connection string).
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=

# 1 = replay the recorded run in fixtures/demo (instant, offline, no keys needed)
DEMO_MODE=0

# Live runs stop starting once a UTC day's measured spend reaches this (dollars)
DAILY_SPEND_CAP_USD=10
